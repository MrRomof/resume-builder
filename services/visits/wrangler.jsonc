{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fourka-resume-visits",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGIN": "https://mrromof.github.io" },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "10011", "simple": { "limit": 60, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "resume-visits", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }]
}
